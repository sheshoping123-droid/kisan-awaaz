# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
WEBHOOK_BASE_URL=http://localhost:8000

# --- Vision Model ---
VISION_PROVIDER=qwen_api
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max
VISION_MAX_IMAGE_BYTES=10485760
VISION_TIMEOUT=30

# --- LLM ---
LLM_PROVIDER=qwen_api
LLM_MODEL=qwen-max
LLM_TIMEOUT=60
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Speech ---
SPEECH_PROVIDER=whisper_api
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
SPEECH_MAX_AUDIO_BYTES=26214400
SPEECH_TIMEOUT=60

# --- RAG ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_RAW_DIR=knowledge/raw
RAG_PROCESSED_DIR=knowledge/processed
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
FAISS_INDEX_PATH=knowledge/processed/index.faiss
METADATA_PATH=knowledge/processed/metadata.json
RAG_TOP_K=5
RAG_CONTEXT_K=3

# --- Database ---
DATABASE_URL=sqlite:///./data/kisan_awaaz.db

# --- Admin ---
ADMIN_API_KEY=
